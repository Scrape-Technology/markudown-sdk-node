{
  "name": "markudown-sdk",
  "version": "0.1.1",
  "description": "Node.js / TypeScript SDK for MarkUDown — AI data extraction infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "bash scripts/release.sh"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "web-scraping",
    "scraping-api",
    "scraper",
    "crawler",
    "data-extraction",
    "markdown",
    "llm",
    "ai-agents",
    "rag",
    "markudown"
  ],
  "homepage": "https://scrapetechnology.com/markudown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scrape-Technology/markudown-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/Scrape-Technology/markudown-sdk-node/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
